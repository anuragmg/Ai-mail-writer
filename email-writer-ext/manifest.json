{
  "name": "Email Writer Assistant",
  "description": "AI Powered Email reply Assistant",
  "version": "1.0",
  "manifest_version": 3,
  "host_permissions": [
    "https://localhost:8080/*",
    "*://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "Web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://mail.google.com/*"]
    }
  ],
  "action": {
    "default_title": "Email Writer Assistant"
  }
}